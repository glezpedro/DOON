// Despliegue en Cloudflare Workers: cada push a main publica la web en doon.es.
{
  "name": "doon",
  "compatibility_date": "2026-09-01",

  // La web es estática: se sirven los archivos del repositorio tal cual.
  "assets": {
    "directory": "./"
  },

  // Solo el dominio propio; sin la dirección *.workers.dev ni URLs de vista previa públicas.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "doon.es", "custom_domain": true },
    { "pattern": "www.doon.es", "custom_domain": true }
  ]
}
